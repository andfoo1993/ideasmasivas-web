<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Historias en inglés</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  background:linear-gradient(135deg,#faf7f2,#f5ebde); color:#2c2c2c; min-height:100vh;
  padding:16px; display:flex; flex-direction:column; align-items:center; }
.wrap { width:100%; max-width:560px; }
h1 { color:#b85c38; font-size:1.5rem; text-align:center; margin:6px 0 2px; }
.sub { text-align:center; color:#6b6b6b; font-size:0.9rem; margin-bottom:14px; }

.modos { display:flex; gap:6px; margin-bottom:10px; }
.modo { flex:1; padding:10px 6px; border:2px solid #e0d5c5; background:#fff; border-radius:12px;
  font-size:0.8rem; font-weight:600; color:#8a6d4f; cursor:pointer; line-height:1.3; }
.modo.activo { background:#b85c38; border-color:#b85c38; color:#fff; }

.velocidades { display:flex; gap:6px; justify-content:center; align-items:center; margin-bottom:12px; flex-wrap:wrap; }
.velocidades span { font-size:0.8rem; color:#6b6b6b; margin-right:4px; }
.vel { padding:6px 10px; border:1px solid #e0d5c5; background:#fff; border-radius:20px;
  font-size:0.8rem; cursor:pointer; color:#8a6d4f; }
.vel.activo { background:#6a8a5e; border-color:#6a8a5e; color:#fff; }

/* Teleprompter */
.prompter { position:relative; height:340px; overflow:hidden; background:#1f1b18;
  border-radius:20px; box-shadow:0 8px 30px rgba(0,0,0,0.15); }
.prompter::before, .prompter::after { content:""; position:absolute; left:0; right:0; height:90px; z-index:2; pointer-events:none; }
.prompter::before { top:0; background:linear-gradient(#1f1b18,rgba(31,27,24,0)); }
.prompter::after { bottom:0; background:linear-gradient(rgba(31,27,24,0),#1f1b18); }
.lista { position:absolute; left:0; right:0; top:0; padding:0 24px;
  transition:transform 0.7s ease; }
.linea { padding:12px 0; text-align:center; opacity:0.25; transition:opacity 0.4s, transform 0.4s; cursor:pointer; }
.linea.pasada { opacity:0.35; }
.linea.activa { opacity:1; transform:scale(1.04); }
.en { color:#fff; font-size:1.35rem; font-weight:600; line-height:1.4; }
.es { color:#f0b48f; font-size:0.95rem; margin-top:4px; }
.modo-2 .es, .modo-3 .es { display:none; }
.modo-3 .linea { visibility:hidden; }
.solo-audio { display:none; position:absolute; inset:0; z-index:3; color:#fff; flex-direction:column;
  align-items:center; justify-content:center; text-align:center; gap:10px; }
.modo-3 .solo-audio { display:flex; }
.solo-audio .icono { font-size:3rem; }
.solo-audio .contador { color:#f0b48f; font-size:1rem; }
.modo-3.revelado .linea { visibility:visible; }
.modo-3.revelado .solo-audio { display:none; }

.controles { display:flex; gap:8px; margin-top:12px; }
.btn { flex:1; padding:14px; border:none; border-radius:14px; font-size:1rem; font-weight:600; cursor:pointer; }
.btn-play { background:#b85c38; color:#fff; flex:2; }
.btn-sec { background:#f0e6d8; color:#8a6d4f; }
.barra { height:6px; background:#e0d5c5; border-radius:3px; margin-top:12px; overflow:hidden; cursor:pointer; }
.barra div { height:100%; width:0; background:#b85c38; }

.ayuda { font-size:0.8rem; color:#6b6b6b; text-align:center; margin-top:10px; }
.calibrar { margin-top:18px; background:#fff; border-radius:14px; padding:14px; font-size:0.85rem; color:#6b6b6b; }
.calibrar summary { cursor:pointer; color:#8a6d4f; font-weight:600; }
.calibrar p { margin:8px 0; }
.calibrar textarea { width:100%; height:60px; margin-top:8px; font-family:monospace; font-size:0.8rem;
  border:1px solid #e0d5c5; border-radius:8px; padding:6px; }
.btn-marca { background:#6a8a5e; color:#fff; }
</style>
</head>
<body>
<div class="wrap">
  <h1 id="titulo"></h1>
  <div class="sub" id="nivel"></div>

  <div class="modos">
    <button class="modo" data-modo="1">1 · Audio<br>+ Texto + Traducción</button>
    <button class="modo" data-modo="2">2 · Audio<br>+ Texto</button>
    <button class="modo" data-modo="3">3 · Solo<br>Audio</button>
  </div>

  <div class="velocidades" id="velocidades"><span>Velocidad:</span></div>

  <div class="prompter" id="prompter">
    <div class="lista" id="lista"></div>
    <div class="solo-audio">
      <div class="icono">🎧</div>
      <div>Escucha con atención</div>
      <div class="contador" id="contador"></div>
    </div>
  </div>

  <div class="barra" id="barra"><div id="progreso"></div></div>

  <div class="controles">
    <button class="btn btn-sec" id="btnAtras">⏮ Frase</button>
    <button class="btn btn-play" id="btnPlay">▶ Reproducir</button>
    <button class="btn btn-sec" id="btnRevelar" style="display:none">👁 Ver</button>
  </div>
  <div class="ayuda">Toca una frase para escucharla de nuevo.</div>

  <details class="calibrar">
    <summary>⚙️ Ajustar tiempos de las frases</summary>
    <p>1. Toca <b>Empezar ajuste</b>: el audio sonará a velocidad normal desde el inicio.<br>
       2. Toca <b>Marcar</b> justo cuando empiece cada frase (desde la frase 2).<br>
       3. Al terminar, los tiempos se guardan en este navegador. Copia el texto de abajo y pégalo en <code>tiempos</code> dentro del código para que funcione en todos los dispositivos.</p>
    <div class="controles">
      <button class="btn btn-sec" id="btnCalibrar">Empezar ajuste</button>
      <button class="btn btn-marca" id="btnMarcar" disabled>Marcar</button>
    </div>
    <textarea id="salidaTiempos" readonly></textarea>
  </details>
</div>

<audio id="audio" preload="metadata"></audio>

<script>
// ===================== DATOS DE LA HISTORIA =====================
// Para agregar historias más adelante, este objeto se moverá a historias.json.
const HISTORIA = {
  id: "h01",
  titulo: "A Saturday Morning",
  nivel: "Nivel A1 · 12 frases",
  audio: "https://hjvecmvzokqsdrdkzucr.supabase.co/storage/v1/object/public/Stories/S01-01.mp3",
  pausa: 1,      // segundos de pausa entre frases en el audio
  tiempos: [],   // pega aquí los tiempos exactos cuando los ajustes, ej: [0, 3.2, 7.1, ...]
  frases: [
    ["This is Leo, and this is Ana.", "Este es Leo, y esta es Ana."],
    ["They live in a small apartment in Bogotá.", "Viven en un apartamento pequeño en Bogotá."],
    ["Today is Saturday, so they don't work.", "Hoy es sábado, así que no trabajan."],
    ["Leo wakes up at eight o'clock.", "Leo se despierta a las ocho."],
    ["He goes to the kitchen and makes coffee.", "Va a la cocina y prepara café."],
    ["Ana makes eggs and toast.", "Ana prepara huevos y pan tostado."],
    ["\"Thank you, Leo. The coffee is very good!\" Ana says.", "\"Gracias, Leo. ¡El café está muy rico!\", dice Ana."],
    ["After breakfast, they walk to the park.", "Después del desayuno, caminan al parque."],
    ["The sun is out, but it is a little cold.", "Hace sol, pero hace un poco de frío."],
    ["Ana sees a small brown dog.", "Ana ve un perro pequeño y café."],
    ["\"I want a dog!\" she says.", "\"¡Quiero un perro!\", dice ella."],
    ["Leo laughs. \"Maybe next year.\"", "Leo se ríe. \"Tal vez el próximo año.\""]
  ]
};
const VELOCIDADES = [0.6, 0.75, 0.9, 1, 1.25];
// ================================================================

const audio = document.getElementById('audio');
const lista = document.getElementById('lista');
const prompter = document.getElementById('prompter');
const btnPlay = document.getElementById('btnPlay');
const KEY = 'historias_' + HISTORIA.id;

let tiempos = [];
let activa = -1;
let finFrase = null;       // para reproducir una sola frase
let modo = parseInt(localStorage.getItem('hist_modo')) || 1;
let velocidad = parseFloat(localStorage.getItem('hist_vel')) || 0.9;
let calibrando = false, marcas = [];

// ---------- Montaje ----------
document.getElementById('titulo').textContent = '📖 ' + HISTORIA.titulo;
document.getElementById('nivel').textContent = HISTORIA.nivel;
audio.src = HISTORIA.audio;

HISTORIA.frases.forEach(([en, es], i) => {
  const d = document.createElement('div');
  d.className = 'linea';
  d.innerHTML = '<div class="en"></div><div class="es"></div>';
  d.querySelector('.en').textContent = en;
  d.querySelector('.es').textContent = es;
  d.onclick = () => reproducirFrase(i);
  lista.appendChild(d);
});

const velBox = document.getElementById('velocidades');
VELOCIDADES.forEach(v => {
  const b = document.createElement('button');
  b.className = 'vel'; b.textContent = v + 'x'; b.dataset.v = v;
  b.onclick = () => ponerVelocidad(v);
  velBox.appendChild(b);
});

document.querySelectorAll('.modo').forEach(b => b.onclick = () => ponerModo(parseInt(b.dataset.modo)));

// ---------- Tiempos ----------
function calcularTiempos() {
  const guardados = JSON.parse(localStorage.getItem(KEY + '_tiempos') || 'null');
  if (HISTORIA.tiempos.length === HISTORIA.frases.length) return HISTORIA.tiempos;
  if (guardados && guardados.length === HISTORIA.frases.length) return guardados;
  // Estimación: reparte la duración según el largo de cada frase, descontando las pausas
  const n = HISTORIA.frases.length;
  const habla = Math.max(audio.duration - HISTORIA.pausa * (n - 1), 1);
  const chars = HISTORIA.frases.map(f => f[0].length);
  const total = chars.reduce((a, b) => a + b, 0);
  const t = []; let acc = 0;
  chars.forEach(c => { t.push(+acc.toFixed(2)); acc += habla * c / total + HISTORIA.pausa; });
  return t;
}
audio.addEventListener('loadedmetadata', () => { tiempos = calcularTiempos(); centrar(0); });

// ---------- Modo y velocidad ----------
function ponerModo(m) {
  modo = m; localStorage.setItem('hist_modo', m);
  document.querySelectorAll('.modo').forEach(b => b.classList.toggle('activo', +b.dataset.modo === m));
  prompter.classList.remove('modo-1', 'modo-2', 'modo-3', 'revelado');
  prompter.classList.add('modo-' + m);
  document.getElementById('btnRevelar').style.display = m === 3 ? 'block' : 'none';
  document.getElementById('btnRevelar').textContent = '👁 Ver';
  setTimeout(() => centrar(Math.max(activa, 0)), 50);
}
function ponerVelocidad(v) {
  velocidad = v; localStorage.setItem('hist_vel', v);
  audio.playbackRate = v;
  document.querySelectorAll('.vel').forEach(b => b.classList.toggle('activo', +b.dataset.v === v));
}

// ---------- Teleprompter ----------
function centrar(i) {
  const lineas = lista.children;
  if (!lineas[i]) return;
  const el = lineas[i];
  const y = prompter.clientHeight / 2 - (el.offsetTop + el.offsetHeight / 2);
  lista.style.transform = `translateY(${y}px)`;
  [...lineas].forEach((l, k) => {
    l.classList.toggle('activa', k === i);
    l.classList.toggle('pasada', k < i);
  });
  document.getElementById('contador').textContent = `Frase ${i + 1} de ${lineas.length}`;
}
function indiceEn(t) {
  let i = 0;
  for (let k = 0; k < tiempos.length; k++) if (tiempos[k] <= t + 0.05) i = k;
  return i;
}
audio.addEventListener('timeupdate', () => {
  if (!tiempos.length) return;
  const i = indiceEn(audio.currentTime);
  if (i !== activa) { activa = i; centrar(i); }
  document.getElementById('progreso').style.width = (audio.currentTime / audio.duration * 100) + '%';
  if (finFrase !== null && audio.currentTime >= finFrase) { audio.pause(); finFrase = null; }
});

// ---------- Reproducción ----------
function reproducirFrase(i) {
  if (calibrando || !tiempos.length) return;
  audio.currentTime = tiempos[i];
  finFrase = i + 1 < tiempos.length ? tiempos[i + 1] - HISTORIA.pausa * 0.6 : null;
  audio.playbackRate = velocidad;
  audio.play();
}
btnPlay.onclick = () => {
  if (audio.paused) {
    finFrase = null;
    if (audio.ended) audio.currentTime = 0;
    audio.playbackRate = calibrando ? 1 : velocidad;
    audio.play();
  } else audio.pause();
};
audio.addEventListener('play', () => btnPlay.textContent = '⏸ Pausa');
audio.addEventListener('pause', () => btnPlay.textContent = '▶ Reproducir');
audio.addEventListener('ended', () => {
  btnPlay.textContent = '↺ Escuchar otra vez';
  if (calibrando) terminarCalibracion();
});
document.getElementById('btnAtras').onclick = () => {
  if (!tiempos.length) return;
  const i = indiceEn(audio.currentTime);
  const destino = audio.currentTime - tiempos[i] > 1.5 ? i : Math.max(i - 1, 0);
  audio.currentTime = tiempos[destino];
};
document.getElementById('barra').onclick = e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = (e.clientX - r.left) / r.width * audio.duration;
};
document.getElementById('btnRevelar').onclick = e => {
  const rev = prompter.classList.toggle('revelado');
  e.target.textContent = rev ? '🙈 Ocultar' : '👁 Ver';
  setTimeout(() => centrar(Math.max(activa, 0)), 50);
};

// ---------- Ajuste manual de tiempos ----------
const btnMarcar = document.getElementById('btnMarcar');
document.getElementById('btnCalibrar').onclick = () => {
  calibrando = true; marcas = [0];
  btnMarcar.disabled = false;
  btnMarcar.textContent = 'Marcar frase 2';
  audio.currentTime = 0; audio.playbackRate = 1; audio.play();
};
btnMarcar.onclick = () => {
  marcas.push(+audio.currentTime.toFixed(2));
  if (marcas.length === HISTORIA.frases.length) terminarCalibracion();
  else btnMarcar.textContent = 'Marcar frase ' + (marcas.length + 1);
};
function terminarCalibracion() {
  calibrando = false; btnMarcar.disabled = true; btnMarcar.textContent = 'Marcar';
  audio.playbackRate = velocidad;
  if (marcas.length === HISTORIA.frases.length) {
    tiempos = marcas;
    localStorage.setItem(KEY + '_tiempos', JSON.stringify(marcas));
    document.getElementById('salidaTiempos').value = 'tiempos: ' + JSON.stringify(marcas) + ',';
  } else {
    document.getElementById('salidaTiempos').value = 'Ajuste incompleto: marcaste ' + marcas.length +
      ' de ' + HISTORIA.frases.length + ' frases. Inténtalo de nuevo.';
  }
}

// ---------- Inicio ----------
ponerModo(modo);
ponerVelocidad(velocidad);
</script>
</body>
</html>
